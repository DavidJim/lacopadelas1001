---
interface Props {
  jornada: number;
  mayorPuntuacion: {
    equipo?: string;
    puntos?: number;
  };
  menorPuntuacion: {
    equipo?: string;
    puntos?: number;
  };
  mejorJugador: {
    nombre?: string;
    puntos?: number;
  };
  mediaJornada?: number;
  mejorBestball?: {
    equipo?: string;
    puntos?: number;
  };
  mayorDiferencia?: {
        equipo1Id?: number;
        equipo2Id?: number;
        equipo1?: string;
        equipo2?: string;
        puntos1?: number;
        puntos2?: number;
        diferencia?: number;
    }
  enJuego: boolean
}

const {
  jornada,
  mayorPuntuacion,
  mejorJugador,
  menorPuntuacion,
  mediaJornada,
  mejorBestball,
  mayorDiferencia,
  enJuego
} = Astro.props;
---

<section class="mx-auto w-full">
  <div class="card bg-transparent">
    <div class="card-body p-1">
        <details class="collapse collapse-arrow bg-transparent border border-primary" name="my-accordion-det-1">
            <summary class="collapse-title">
                <!-- Cabecera -->
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h2 class="text-xl font-bold">
                            Estadísticas de la jornada {jornada}
                        </h2>

                        <p class="text-sm text-base-content/60">
                            Los datos más destacados de esta jornada
                        </p>
                    </div>
                </div>
            </summary>
            <div class="collapse-content">
                <!-- Estadísticas -->
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">

                    <!-- Mayor puntuación -->
                    <div class="rounded-box bg-transparent border border-accent p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="2.5em" height="2.5em" viewBox="0 0 80 80"><title>star</title><g fill="none"><path fill="#f2994a" d="M38.144 12.622c.672-1.673 3.04-1.673 3.712 0l5.952 14.822a2 2 0 0 0 1.72 1.25l15.937 1.08c1.798.122 2.53 2.375 1.147 3.53L54.354 43.547a2 2 0 0 0-.657 2.023l3.897 15.49c.44 1.748-1.476 3.14-3.003 2.181l-13.528-8.492a2 2 0 0 0-2.126 0L25.409 63.24c-1.527.959-3.443-.433-3.003-2.181l3.897-15.49a2 2 0 0 0-.657-2.023L13.388 33.305c-1.383-1.156-.652-3.408 1.147-3.53l15.936-1.081a2 2 0 0 0 1.72-1.25z"/><path fill="#f2c94c" d="M39.052 26.31c.335-.836 1.52-.836 1.855 0l2.977 7.412a1 1 0 0 0 .86.625l7.968.54c.9.061 1.265 1.187.573 1.765l-6.128 5.12a1 1 0 0 0-.329 1.012l1.948 7.745c.22.874-.738 1.57-1.501 1.091l-6.764-4.246a1 1 0 0 0-1.063 0l-6.764 4.246c-.763.48-1.721-.216-1.501-1.09l1.948-7.746a1 1 0 0 0-.329-1.011l-6.128-5.12c-.692-.579-.326-1.705.573-1.766l7.968-.54a1 1 0 0 0 .86-.625z"/></g></svg>
                    {enJuego ? (<p class="text-sm text-base-content/60">
                        Mayor puntuación momentánea
                    </p>):
                    (<p class="text-sm text-base-content/60">
                        Mayor puntuación
                    </p>)
                    }

                    <p class="mt-1 text-2xl font-bold">
                        {mayorPuntuacion?.puntos?.toFixed(2)}
                    </p>

                    <p class="truncate text-sm font-medium">
                        {mayorPuntuacion?.equipo}
                    </p>
                    </div>
                    <!-- Menor puntuación -->
                    {!enJuego && (<div class="rounded-box bg-transparent border border-accent p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 32 32"><title>thumbs-down</title><g fill="none"><path fill="#ffc83d" d="M19.688 26.44c0 2.9-2.125 3.584-3.313 3.563c-2.412 0-3.082-2.01-3.281-3.078c-.248-1.33-.005-4.51.106-5.97l.003-.04q-.238.056-.515.057H8.83c-1.56 0-2.83-1.27-2.83-2.83c0-.806.259-1.535.765-2.051C5.721 15.63 5 14.663 5 13.548c0-1.023.463-1.921 1.364-2.418C5.541 10.618 5 9.764 5 8.798c0-1.108.543-2.07 1.598-2.534C6.223 5.878 6 5.304 6 4.47c0-1.379.969-2.502 2.83-2.502h3.858q.068 0 .134.004h3.131C26.391 1.8 27 8.565 27 11.315c0 5.156-2.298 6.69-4.34 8.052c-.966.644-1.875 1.25-2.457 2.183c-.488.782-.515 1.5-.515 4.89"/><path fill="#d67d00" d="M14.394 6.913H9a.5.5 0 0 1 0-1h5.549c.333-.509.467-1.085.467-1.443c0-1.085-.607-2.228-1.855-2.46c2.562.106 3.87 1.28 3.87 2.68c0 1.175-.708 1.869-1.062 2.068c.654.469 1.062 1.157 1.062 2.089c0 1.234-1.062 2.265-1.062 2.265s1.062.938 1.062 2.219c0 1.15-.5 2.078-1.062 2.328c.562.39 1.031 1.094 1.031 2.344c0 2.375-2.98 2.937-4 2.969v-.02c1.573-.21 2.016-2 2.016-2.81c0-.687-.28-1.574-.843-2.17H9a.5.5 0 0 1 0-1h5.62c.28-.52.396-1.067.396-1.424c0-.751-.253-1.527-.767-2.076H9a.5.5 0 0 1 0-1h5.47c.39-.586.546-1.259.546-1.674c0-.467-.14-1.258-.622-1.885"/></g></svg>
                    <p class="text-sm text-base-content/60">
                        Menor puntuación
                    </p>

                    <p class="mt-1 text-2xl font-bold">
                        {menorPuntuacion?.puntos?.toFixed(2)}
                    </p>

                    <p class="truncate text-sm font-medium">
                        {menorPuntuacion?.equipo}
                    </p>
                    </div>)}

                    <!-- Mejor jugador -->
                    <div class="rounded-box bg-transparent border border-accent p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 128 128"><title>rugby-football</title><path fill="#f79329" d="M117.03 11c-.09-.08-.18-.16-.27-.25c-.01-.01-.02-.01-.03-.03c-4.63-5.04-20.76-2.84-41.89 10.58c-.53.33-1.06.7-1.6 1.05c-1.15-1.25-2.55-2.33-4.13-3.25c.97-.65 1.95-1.31 2.92-1.92C84.75 9.1 96.48 4.54 105.53 3.75C84.58-4.35 50.92 2.66 26.8 26.77C1.03 52.52-5.26 89.17 5.58 109.59c.03-10.19 5.13-24.4 14.78-39.91c.34-.55.73-1.08 1.07-1.63c1.33.93 2.8 1.76 4.36 2.47c-.41.63-.85 1.25-1.25 1.89c-14.15 22.76-16.82 40.78-11.97 46.04c18.49 15.87 60.19 11.19 88.63-17.24c29.28-29.26 33.42-72.6 15.83-90.21"/><path fill="#fff" d="M73.14 29.27c-.82-3.95-4.22-6.71-7.85-8.17c-1.33-.53-2.94-1.03-4.42-.82c-1.2.18-2.68.26-3.7 1.04c-.47.36-1 1.01-1.06 1.6c-.08.81.64 1.41.33 2.33c-.26.74-1.13.94-1.81.96c-2.7.07-6-1.13-8.31.9c-1.42 1.25-1.45 2.75-.79 4.24c.14.58.3 1.16.15 1.75c-.37 1.49-1.8 1.22-3.01 1.33c-.07.01-.13.02-.2.04c-.52-.09-1.04-.17-1.56-.2c-2.91-.14-5.72.99-6.49 4.05c-.34 1.32-.15 2.54.39 3.64c.2 1.32.68 2.85-1.01 3.45c-.55.19-1.08.2-1.58.47c-1.64.28-3.26.84-4.43 1.78c-.93.76-1.44 2.15-1.77 3.28c-.28.94-.07 2.12.56 2.8c.49.52 1.22 1.36.3 2.01c-.59.43-1.75.41-2.46.52c-1.38.23-2.77 1.27-3.38 2.59c-.14.31-.25.64-.29.98c-.32 2.31.84 4 2.6 5.26a24.4 24.4 0 0 0 6.12 3.12c1.17.4 2.38.63 3.62.69c1.87.11 3.93-.81 4.46-2.79c.73-2.71-1.96-3.65-2.35-5.93c-.29-1.63 4.27-.47 4.97-.43c1.65.1 3.32-.63 4.32-1.96c1.3-1.7 1.18-4.44.01-6.19c-.14-.21-.31-.37-.46-.56c0-.01.02-.02.01-.05c-.03-.36-.42-.6-.47-.97c-.05-.48.23-.84.71-.86c.06 0 .14.02.22.04c1.32.46 2.71.76 4.1.76c2.36 0 4.5-.51 5.31-2.94c.81-2.42-.12-4.87-1.76-6.94c-.13-.26-.23-.52-.12-.8c.15-.37.51-.4.91-.31c.2.05.4.12.6.19c3 1.75 7.56 3.21 9.8.46c1.65-2.05-.61-4.19-.07-6.41c.22-.91 1.45-1.06 2.26-.9c.65.12 1.25.52 1.81.83c1.34.74 3.8 1.16 5.19.08c1.22-.91.86-2.72.6-3.96"/></svg>
                    <p class="text-sm text-base-content/60">
                        Mejor jugador
                    </p>

                    <p class="mt-1 text-lg font-bold truncate">
                        {mejorJugador?.nombre}
                    </p>

                    <p class="text-sm font-medium">
                        {mejorJugador?.puntos?.toFixed(2)} pts
                    </p>
                    </div>

                    <!-- Media -->
                    <div class="rounded-box bg-transparent border border-accent p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 16 16"><title>people-community-16</title><g fill="none"><path fill="url(#SVGKRWFxbqL)" d="M10.99 7.714a1.5 1.5 0 0 0-1.838 1.061l-.388 1.449a3 3 0 1 0 5.796 1.553l.388-1.45a1.5 1.5 0 0 0-1.06-1.836z"/><path fill="url(#SVGS55hfcEo)" d="M5.01 7.714a1.5 1.5 0 0 1 1.837 1.061l.388 1.449a3 3 0 1 1-5.795 1.553l-.389-1.45a1.5 1.5 0 0 1 1.061-1.836z"/><path fill="url(#SVGhPA51cUi)" d="M6.5 7A1.5 1.5 0 0 0 5 8.5V11a3 3 0 1 0 6 0V8.5A1.5 1.5 0 0 0 9.5 7z"/><path fill="url(#SVGdS1RictV)" d="M8 1a2.5 2.5 0 1 0 0 5a2.5 2.5 0 0 0 0-5"/><path fill="url(#SVGz0rZgdQY)" d="M3 3a2 2 0 1 0 0 4a2 2 0 0 0 0-4"/><path fill="url(#SVGvwvajdxI)" d="M13 3a2 2 0 1 0 0 4a2 2 0 0 0 0-4"/><defs><radialGradient id="SVGKRWFxbqL" cx="0" cy="0" r="1" gradientTransform="rotate(78.837 -.336 11.297)scale(4.64914)" gradientUnits="userSpaceOnUse"><stop stop-color="#0078d4"/><stop offset="1" stop-color="#004695"/></radialGradient><radialGradient id="SVGS55hfcEo" cx="0" cy="0" r="1" gradientTransform="rotate(61.056 -5.472 6.145)scale(6.90379 4.96937)" gradientUnits="userSpaceOnUse"><stop stop-color="#008ce2"/><stop offset="1" stop-color="#0068c6"/></radialGradient><radialGradient id="SVGhPA51cUi" cx="0" cy="0" r="1" gradientTransform="rotate(63.608 -3.915 10.713)scale(4.22417 3.87907)" gradientUnits="userSpaceOnUse"><stop offset=".339" stop-color="#3dcbff"/><stop offset="1" stop-color="#14b1ff"/></radialGradient><radialGradient id="SVGdS1RictV" cx="0" cy="0" r="1" gradientTransform="rotate(59.931 1.37 7.898)scale(3.12306)" gradientUnits="userSpaceOnUse"><stop offset=".339" stop-color="#3dcbff"/><stop offset="1" stop-color="#14b1ff"/></radialGradient><radialGradient id="SVGz0rZgdQY" cx="0" cy="0" r="1" gradientTransform="rotate(47.573 -3.7 4.554)scale(3.27979)" gradientUnits="userSpaceOnUse"><stop stop-color="#008ce2"/><stop offset="1" stop-color="#0068c6"/></radialGradient><radialGradient id="SVGvwvajdxI" cx="0" cy="0" r="1" gradientTransform="rotate(78.837 3.672 9.578)scale(2.93403)" gradientUnits="userSpaceOnUse"><stop stop-color="#0078d4"/><stop offset="1" stop-color="#004695"/></radialGradient></defs></g></svg>
                    <p class="text-sm text-base-content/60">
                        Media de la jornada
                    </p>

                    <p class="mt-1 text-2xl font-bold">
                        {mediaJornada?.toFixed(2)}
                    </p>

                    <p class="text-sm text-base-content/60">
                        puntos por equipo
                    </p>
                    </div>

                    <!-- Mejor Best Ball -->
                    {
                    mejorBestball && (
                        <div class="rounded-box bg-transparent border border-accent p-4">
                        <p class="text-sm text-base-content/60">
                            Mejor Best Ball
                        </p>

                        <p class="mt-1 text-2xl font-bold">
                            {mejorBestball?.puntos?.toFixed(2)}
                        </p>

                        <p class="truncate text-sm font-medium">
                            {mejorBestball?.equipo}
                        </p>
                        </div>
                    )
                    }

                    <!-- Mayor diferencia-->
                    {
                    mayorDiferencia && (
                        !enJuego && (<div class="rounded-box bg-transparent border border-accent p-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 36 36"><title>skull-and-crossbones</title><path fill="#ccd6dd" d="M27.865 16.751c0-6.242-4.411-9.988-9.927-9.988s-9.835 3.746-9.835 9.988c0 3.48-.103 6.485 3.897 7.89v2.722c0 1.034.966 1.872 2 1.872s2-.838 2-1.872v-1.97v1.97c0 1.034.965 1.872 2 1.872s2-.838 2-1.872v-1.97v1.97c0 1.034.966 1.872 2 1.872s2-.838 2-1.872v-2.722c4-1.405 3.865-4.41 3.865-7.89"/><circle cx="13.629" cy="15.503" r="3.121" fill="#292f33"/><path fill="#292f33" d="M25.488 15.503c0 1.724 0 3.121-3.121 3.121s-3.12-1.397-3.12-3.121a3.12 3.12 0 1 1 6.241 0m-6.301 5.656c-.157-.382-.626-.662-1.189-.662c-.561 0-1.031.28-1.188.662a.934.934 0 1 0 1.132 1.206l.056.004l.057-.004a.934.934 0 1 0 1.132-1.206"/><path fill="#aab8c2" d="M11 27c0-.367.075-.713.195-1.038c-.984-.447-1.831-1.082-2.503-1.97a280 280 0 0 1-3.127 2.695A3.47 3.47 0 0 0 3.5 26A3.5 3.5 0 0 0 0 29.5a3.49 3.49 0 0 0 3.046 3.454A3.49 3.49 0 0 0 6.5 36a3.5 3.5 0 0 0 3.5-3.5c0-.775-.26-1.485-.686-2.065c.6-.706 1.246-1.46 1.931-2.25A3 3 0 0 1 11 27m16.872-15.482c.884-.769 1.729-1.495 2.515-2.163A3.47 3.47 0 0 0 32.4 10a3.5 3.5 0 0 0 3.5-3.5a3.49 3.49 0 0 0-2.945-3.444A3.49 3.49 0 0 0 29.5 0A3.5 3.5 0 0 0 26 3.5c0 .775.26 1.485.687 2.065c-.594.7-1.233 1.445-1.911 2.227c1.3.871 2.361 2.095 3.096 3.726M3.5 10a3.47 3.47 0 0 0 2.065-.687c.799.679 1.661 1.419 2.564 2.204c.735-1.631 1.795-2.855 3.096-3.726a279 279 0 0 1-1.912-2.226A3.47 3.47 0 0 0 10 3.5A3.5 3.5 0 0 0 6.5 0a3.49 3.49 0 0 0-3.454 3.046A3.49 3.49 0 0 0 0 6.5A3.5 3.5 0 0 0 3.5 10m28.9 16c-.752 0-1.444.242-2.014.645c-.952-.809-1.99-1.701-3.079-2.653c-.672.889-1.519 1.523-2.503 1.971c.121.324.196.67.196 1.037c0 .421-.088.821-.245 1.185c.685.79 1.331 1.544 1.931 2.25A3.48 3.48 0 0 0 26 32.5c0 1.934 1.566 3.5 3.5 3.5a3.49 3.49 0 0 0 3.455-3.056A3.49 3.49 0 0 0 35.9 29.5c0-1.934-1.566-3.5-3.5-3.5"/></svg>
                        <p class="text-sm text-base-content/60">
                            Mayor diferencia
                        </p>

                        <p class="mt-1 text-2xl font-bold">
                            {mayorDiferencia?.diferencia?.toFixed(2)}
                        </p>

                        <p class="truncate text-sm font-medium">
                            {mayorDiferencia?.equipo1} {mayorDiferencia?.puntos1?.toFixed(2)}
                        </p>
                        <p class="truncate text-sm font-medium">
                            {mayorDiferencia?.equipo2} {mayorDiferencia?.puntos2?.toFixed(2)}
                        </p>
                        </div>)
                    )
                    }

                </div>
            </div>
        </details>


        <!-- <a
          href="/estadisticas"
          class="btn btn-sm btn-outline"
        >
          Ver más
          <span aria-hidden="true">→</span>
        </a> -->
    </div>
  </div>
</section>
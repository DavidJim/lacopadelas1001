---
import "../styles/global.css";
import { obtenerEquipo } from "../lib/equipos";

interface Props {
  equipoId: number;
  puntos?: string | number;
}

const { equipoId, puntos } = Astro.props;
const equipo = obtenerEquipo(equipoId);
---
    <div class="card bg-primary text-primary-content rounded-box grid h-20 w-full place-items-center">
        {equipo?.nombre}
        {puntos !== undefined && (
            <div class="text-sm font-bold text-primary-content/60">
                {puntos} PTS
            </div>
        )}
    </div>


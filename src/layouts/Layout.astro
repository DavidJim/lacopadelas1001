---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "La Copa de las 1001" } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="copa-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="La Copa de Las 1001 Fantasy" />
    <title>{title}</title>
    <script is:inline>
        const savedTheme = localStorage.getItem("theme") || "copa-dark";
        document.documentElement.setAttribute("data-theme", savedTheme);
    </script>
  </head>

  <body class="min-h-screen flex flex-col copa-gradient text-base-content">
    <!-- HEADER FIJO -->
    <header class="top-0 z-50">
        <div class="relative flex justify-center px-4 py-3">

            <!-- Navegación -->
            <div class="join">
            <a href="/equipos" class="btn bg-primary text-primary-content join-item rounded-l-full shadow-lg">
                Equipos
            </a>

            <a href="/" class="btn bg-primary text-primary-content join-item shadow-lg">
                Inicio
            </a>

            <a href="/jugadores" class="btn bg-primary text-primary-content join-item rounded-r-full shadow-lg">
                Jugadores
            </a>
            </div>

            <!-- Toggle tema -->
            <button
            id="theme-toggle"
            type="button"
            class="btn btn-circle btn-ghost absolute right-4"
            aria-label="Cambiar tema"
            title="Cambiar tema"
            >
            <!-- Sol -->
            <svg
                id="sun-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="hidden h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>

            <!-- Luna -->
            <svg
                id="moon-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            </button>
    </div>
    </header>
    <section class="flex justify-center">
      <img
        src="/logo-copa.avif"
        alt="La Copa de las 1001"
        class="h-auto max-h-48 w-auto max-w-[80%] object-contain md:max-h-64"
      />
    </section>

    <script is:inline>
        const toggle = document.getElementById("theme-toggle");
        const sun = document.getElementById("sun-icon");
        const moon = document.getElementById("moon-icon");

        function updateThemeIcon(theme) {
            if (theme === "copa-dark") {
            sun?.classList.remove("hidden");
            moon?.classList.add("hidden");
            } else {
            sun?.classList.add("hidden");
            moon?.classList.remove("hidden");
            }
        }

        toggle?.addEventListener("click", () => {
            const current =
            document.documentElement.getAttribute("data-theme") || "copa-light";

            const next =
            current === "copa-dark"
                ? "copa-light"
                : "copa-dark";

            document.documentElement.setAttribute("data-theme", next);
            localStorage.setItem("theme", next);

            updateThemeIcon(next);
        });

        const currentTheme =
            document.documentElement.getAttribute("data-theme") || "copa-light";

        updateThemeIcon(currentTheme);
    </script>

    <!-- CONTENIDO -->
    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-4 md:px-6">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="mt-12 border-t border-base-300 bg-base-100">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-8 text-center md:flex-row md:justify-between md:text-left"
      >
        <div>
          <p class="font-semibold">La Copa de las 1001</p>
          <p class="text-sm text-base-content/60">
            Las 1001 Fantasy
          </p>
        </div>

        <div class="flex gap-5 text-sm">
          <a target="_blank" href="https://www.las1001fantasy.com/_files/ugd/a7a386_35795666e3b645a486f6fc5257db6db3.pdf" class="link link-hover">
            Normativa Copa
          </a>

          <a target="_blank" href="https://www.instagram.com/las1001fantasy/" class="link link-hover">
            Instagram
          </a>

          <a target="_blank" href="https://x.com/las1001fantasy" class="link link-hover">
            X
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
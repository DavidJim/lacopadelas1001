---
import Layout from "../layouts/Layout.astro";
import Enfrentamiento from "../components/Enfrentamiento.astro";
import { getJornadaActual, getJornadaPorNumero, obtenerRonda, obtenerRondas } from "../lib/jornadas";
import { calcularBestballEquipo, calcularPuntuacionRonda, obtenerPuntos } from "../lib/puntuaciones";
import { obtenerEquipo } from "../lib/equipos";
import { calcularEstadisticasJornada } from "../lib/estadisticas";
import enfrentamientosData from "../../data/enfrentamientos.json";
import EstadisticasJornada from "../components/EstadisticasJornada.astro";
import "../styles/global.css";

const puntos = await obtenerPuntos();
const jornadaParam = Astro.url.searchParams.get("semana");
const jornadaActual = jornadaParam
    ? getJornadaPorNumero(Number(jornadaParam))
    : getJornadaActual();
const jornadaSeleccionada = jornadaActual.jornada.jornada;
const estado = jornadaActual.estado;
const rondaActual = obtenerRonda(jornadaActual.jornada.ronda);
const enfrentamientosRonda = enfrentamientosData.filter(enfrentamiento => enfrentamiento.ronda === jornadaActual.jornada.ronda)
const rondas = obtenerRondas();
const datosEnfrentamientos = await Promise.all(enfrentamientosRonda.map( async (enfrentamiento) => 
{ const equipo1 = obtenerEquipo( enfrentamiento.equipo1Id ); 
  const equipo2 = obtenerEquipo( enfrentamiento.equipo2Id ); 
  const bestball1 = await calcularBestballEquipo( enfrentamiento.equipo1Id, jornadaSeleccionada, puntos); 
  const bestball2 = await calcularBestballEquipo( enfrentamiento.equipo2Id, jornadaSeleccionada, puntos);
  const puntuacionRondaEquipo1 = await calcularPuntuacionRonda(enfrentamiento.equipo1Id, enfrentamiento, puntos);
  const puntuacionRondaEquipo2 = await calcularPuntuacionRonda(enfrentamiento.equipo2Id, enfrentamiento, puntos) 
 
  return { ...enfrentamiento, equipo1, equipo2, bestball1, bestball2, puntuacionRondaEquipo1, puntuacionRondaEquipo2 }; 
}));

const estadisticas = calcularEstadisticasJornada( datosEnfrentamientos );
---

<Layout title="La Copa de las 1001 | Inicio">

  <!-- CABECERA DE LA RONDA -->
  <section class="mb-8 text-center">
    <p class="mb-2 text-sm font-medium uppercase tracking-widest text-base-content/60">
      La página no oficial de seguimiento de la Copa de las 1001
    </p>
    <!-- SELECTOR DE RONDA -->
    <h2 class="text-xl font-bold md:text-xl mb-2">
      Selector de ronda
    </h2>
    <div class="mb-4 flex justify-center">
        <select
            class="select select-lg select-accent w-full max-w-xs"
            onchange="window.location.href = `?semana=${this.value}`"
        >
            {rondas.map((ronda) => (
                <option
                    value={ronda.primeraJornada}
                    selected={ronda.ronda === jornadaActual.jornada.ronda}
                >
                    {ronda.nombre}
                </option>
            ))}
        </select>
    </div>

    <!-- ... -->

    <h1 class="text-3xl font-bold md:text-4xl">
      {jornadaActual.jornada.rondaNombre}
    </h1>

    <!-- IDA / VUELTA -->
    <div class="mt-5 flex justify-center">
		<div class="tabs tabs-boxed">
			{rondaActual.map((ronda, index) => (
				<a  href={`?semana=${ronda.jornada}`} class:list={["tab", ronda.jornada === jornadaSeleccionada && "tab-active", "font-bold"]}>
					PARTIDO {index + 1}
				</a>
			))}
		</div>
    </div>
    {estado === "enJuego" && (
      <div role="alert" class="alert alert-warning">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Jornada en juego. Datos reales provisionales con actualización progresiva.</span>
      </div>
      )}
  </section>
    <div class="m-4 flex justify-center">
    <label class="input">
      <svg
        class="h-[1em] opacity-50"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
      >
        <g
          stroke-linejoin="round"
          stroke-linecap="round"
          stroke-width="2.5"
          fill="none"
          stroke="currentColor"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </g>
      </svg>

      <input
        id="buscador-enfrentamientos"
        type="search"
        class="grow"
        placeholder="Buscar enfrentamiento..."
      />
    </label>
  </div>
  {(enfrentamientosRonda.length > 0 && estado !== "futura") && (
    <EstadisticasJornada
      jornada={jornadaSeleccionada}
      mayorPuntuacion={{
        equipo: estadisticas?.maxima?.nombre,
        puntos: estadisticas?.maxima?.puntos
      }}
      menorPuntuacion={{
        equipo: estadisticas?.minima?.nombre,
        puntos: estadisticas?.minima?.puntos
      }}
      mejorJugador={{
        nombre: estadisticas?.jugadorJornada?.nombre,
        puntos: estadisticas?.jugadorJornada?.puntos
      }}
      mediaJornada={estadisticas?.media}
      mayorDiferencia={{
        equipo1: estadisticas?.mayorDiferencia?.equipo1,
        equipo2: estadisticas?.mayorDiferencia?.equipo2,
        puntos1: estadisticas?.mayorDiferencia?.puntos1,
        puntos2: estadisticas?.mayorDiferencia?.puntos2,
        diferencia: estadisticas?.mayorDiferencia?.diferencia
      }}
      estado={estado}
    />)
  }

  <!-- ENFRENTAMIENTOS -->
  <section id="lista-enfrentamientos" class="enfrentamiento mb-8 text-center">
    {enfrentamientosRonda.length > 0 ? (
      datosEnfrentamientos.map((enfrentamiento) => (
        <div
          class="enfrentamiento-item"
          data-equipos={`${enfrentamiento?.equipo1?.nombre} ${enfrentamiento?.equipo2?.nombre}`}
        >
        <Enfrentamiento
          estado={estado}        
	    	  equipo1={enfrentamiento.equipo1}
          equipo2={enfrentamiento.equipo2}
          jornada={jornadaSeleccionada}
          bestBall1={enfrentamiento.bestball1}
          bestBall2={enfrentamiento.bestball2}
          puntuacionRondaEquipo1={enfrentamiento.puntuacionRondaEquipo1}
          puntuacionRondaEquipo2={enfrentamiento.puntuacionRondaEquipo2}
        />
        </div>
      ))
    ) : (
    <div class="flex h-96 w-full items-center justify-center">
      <p class="text-accent text-xl">Enfrentamientos por definir para esta ronda.</p>
    </div>
    )}
  </section>

</Layout>

<script>
  const buscador = document.querySelector<HTMLInputElement>("#buscador-enfrentamientos");
  const enfrentamientos = document.querySelectorAll<HTMLElement>(".enfrentamiento-item");

  buscador?.addEventListener("input", () => {
    const texto = buscador.value.trim().toLowerCase();

    enfrentamientos.forEach((enfrentamiento) => {
      const equipos =
        enfrentamiento.dataset.equipos?.toLowerCase() ?? "";

      enfrentamiento.classList.toggle(
        "hidden",
        !equipos.includes(texto)
      );
    });
  });
</script>
---
import Layout from "../../layouts/Layout.astro";
import { obtenerPuntosJugadorDetalle } from "../../lib/jugadores";
import rostersData from "../../../data/rosters.json";

const { jugadorId } = Astro.params;

const jugador = await obtenerPuntosJugadorDetalle(Number(jugadorId));
const rosterNumber = rostersData.filter(roster => roster.jugadores.some(j => j === Number(jugadorId))).length;
---

<Layout title={`La Copa de las 1001 | ${jugador?.jugador?.nombre ?? "Jugador"}`}>

  {jugador.jugador ? (
    <main>
        <div class="hero">
            <div class="hero-content flex-col lg:flex-row">
                <img
                src={jugador?.jugador?.foto && jugador.jugador.foto !== "" ? jugador.jugador.foto : "/helmet.png"}
                class="max-w-[200px] rounded-lg shadow-2xl"
                />
                <div>
                <h1 class="text-4xl font-bold">{jugador?.jugador?.nombre}</h1>
                <h1 class="text-2xl">{jugador?.jugador?.posicion}</h1>
                <h1 class="text-2xl text-accent">{jugador?.puntosTotales.toFixed(2)} PTS Totales</h1>
                <p class="text-md">Alineado en {rosterNumber} equipos</p>
                </div>
            </div>
        </div>
        <ul class="timeline timeline-vertical">
        { jugador?.puntosPorJornada?.length > 0 && jugador.puntosPorJornada.map((jornada, index) => (
            <li>
                <hr />
                <div class="timeline-start timeline-box border-accent">
                    <div class=" text-lg">Semana {jornada.jornada}</div>
                    <div class="text-lg font-bold">{jornada.puntos.toFixed(2)} PTS</div>
                </div>
                <div class="timeline-middle">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-6 w-6 text-accent"
                >
                    <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                    clip-rule="evenodd"
                    />
                </svg>
                </div>
                <hr />
            </li>
            )  
        )}
        </ul>
    </main>
  ) : (
    <div class="flex h-96 w-full items-center justify-center">
      <p class="text-accent text-xl">Jugador no encontrado</p>
    </div>
  )}

</Layout>
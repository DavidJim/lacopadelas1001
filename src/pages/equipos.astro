---
import Layout from "../layouts/Layout.astro";
import equiposData from "../../data/equipos.json";
import TeamCard from "../components/TeamCard.astro";
import "../styles/global.css";
---

<Layout title="La Copa de las 1001 | Equipos">

  <div class="overflow-x-auto">
    <div class="flex justify-center">    
        <h1 class="flex text-3xl font-bold md:text-4xl">
            EQUIPOS PARTICIPANTES
        </h1>
    </div>
    <div class="m-4 flex justify-center">
      <label class="input">
        <svg
          class="h-[1em] opacity-50"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
        >
          <g
            stroke-linejoin="round"
            stroke-linecap="round"
            stroke-width="2.5"
            fill="none"
            stroke="currentColor"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </g>
        </svg>

        <input
          id="buscador-equipos"
          type="search"
          class="grow"
          placeholder="Buscar equipo..."
        />
      </label>
    </div>

    <div id="lista-equipos" class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {equiposData.map((equipo) => (
        <div
          class="equipo mb-4 md:grid md:grid-cols-[1fr_auto] md:gap-4"
          data-nombre={equipo.nombre.toLowerCase()}
        >
          <a href={`/equipos/${equipo.id}`}>
            <TeamCard equipoId={equipo.id} />
          </a>
        </div>
      ))}
    </div>

  </div>

</Layout>

<script>
  const buscador = document.querySelector<HTMLInputElement>("#buscador-equipos");
  const equipos = document.querySelectorAll<HTMLElement>(".equipo");

  buscador?.addEventListener("input", () => {
    const busqueda = buscador.value.toLowerCase().trim();

    equipos.forEach((equipo) => {
      const nombre = equipo.dataset.nombre ?? "";

      equipo.style.display = nombre.includes(busqueda)
        ? ""
        : "none";
    });
  });
</script>